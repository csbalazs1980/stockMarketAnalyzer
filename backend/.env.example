# Copy to .env (docker compose reads it automatically) and adjust as needed.

# --- application database ---
POSTGRES_DB=stockmarket
POSTGRES_USER=stockmarket
POSTGRES_PASSWORD=stockmarket
POSTGRES_PORT=5432
ADMINER_PORT=8081

# --- Keycloak ---
# Upstream community image from Quay -- pulls anonymously, no registry login needed.
# The Red Hat build (registry.redhat.io/rhbk/keycloak-rhel9:26.6) is the same codebase and
# the same configuration surface, but requires `docker login registry.redhat.io` first.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.6
KEYCLOAK_PORT=8180
KEYCLOAK_MGMT_PORT=9000
# Bootstrap account for the master-realm admin console at http://localhost:8180/admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Keycloak's database: its own role + database inside the same Postgres container as the app.
# Created idempotently by the keycloak-db-init one-shot service.
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak

# --- Spring Boot (export these in your shell / run configuration) ---
DB_URL=jdbc:postgresql://localhost:5432/stockmarket
DB_USERNAME=stockmarket
DB_PASSWORD=stockmarket
SERVER_PORT=8080
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/stockmarket
