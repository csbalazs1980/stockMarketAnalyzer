# Root of the Lombok config tree for this project.
config.stopBubbling = true

# Mark generated members with @lombok.Generated so JaCoCo / SonarQube skip them.
lombok.addLombokGeneratedAnnotation = true

# Do not emit @java.beans.ConstructorProperties -- it pulls in the java.desktop module
# and confuses some JSON binders.
lombok.anyConstructor.addConstructorProperties = false

# Reminder: avoid @Data / @EqualsAndHashCode on JPA entities. Field-wide equality breaks
# Hibernate's identity guarantees for lazy proxies and detached instances. Entities extend
# common.BaseEntity, which implements proxy-safe equals()/hashCode() against the primary key
# once for all of them (both final, so a subclass cannot override them by accident).
